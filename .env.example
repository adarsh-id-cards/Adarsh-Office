# =============================================================================
# PRO OFFICE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and customize values for your environment.
# Ports are intentionally isolated from existing Adarsh ID Cards services.
# =============================================================================

# --- Project & Environment ---
PROJECT_NAME=pro-office
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production-use-at-least-50-random-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Timezone ---
TZ=Asia/Kolkata

# --- PostgreSQL Database ---
POSTGRES_DB=pro_office_db
POSTGRES_USER=pro_office_user
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# --- Security, CORS & CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5178,http://127.0.0.1:5178,http://localhost:8088,http://127.0.0.1:8088
CSRF_TRUSTED_ORIGINS=http://localhost:5178,http://127.0.0.1:5178,http://localhost:8088,http://127.0.0.1:8088
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# --- Initial Administrator Bootstrap (used by `python manage.py create_initial_admin`) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@adarshidcards.local
INITIAL_ADMIN_FULL_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=

# --- Host Port Bindings (Isolated from default ports 80/5432/8000/5173) ---
PRO_OFFICE_HTTP_PORT=8088
PRO_OFFICE_BACKEND_PORT=8008
PRO_OFFICE_FRONTEND_PORT=5178
PRO_OFFICE_DB_PORT=5434

# --- Frontend Build / Runtime Variables ---
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Pro Office
VITE_APP_COMPANY=Adarsh ID Cards
VITE_BACKEND_PROXY_TARGET=http://localhost:8008
