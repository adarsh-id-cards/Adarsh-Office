# =============================================================================
# PRO OFFICE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` on the target deployment host and customize secrets & ports.
# Isolated from existing Adarsh ID Cards production ports and containers.
# =============================================================================

PROJECT_NAME=pro-office
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_64_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=pro-office.adarshidcards.com,localhost,127.0.0.1,backend

TZ=Asia/Kolkata

POSTGRES_DB=pro_office_prod_db
POSTGRES_USER=pro_office_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=https://pro-office.adarshidcards.com,http://localhost:8088
CSRF_TRUSTED_ORIGINS=https://pro-office.adarshidcards.com,http://localhost:8088

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False

INITIAL_ADMIN_USERNAME=adarsh.admin
INITIAL_ADMIN_EMAIL=owner@adarshidcards.com
INITIAL_ADMIN_FULL_NAME=Adarsh Owner
INITIAL_ADMIN_PASSWORD=

# Configurable isolated host ports
PRO_OFFICE_HTTP_PORT=8088
PRO_OFFICE_BACKEND_PORT=8008
PRO_OFFICE_FRONTEND_PORT=5178
PRO_OFFICE_DB_PORT=5434

VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Pro Office
VITE_APP_COMPANY=Adarsh ID Cards
